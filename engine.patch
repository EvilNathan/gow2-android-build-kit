+// handful of 2048-byte sectors) costs one host read instead of one per sector.
+// Android's Storage Access Framework makes every descriptor read cross into the
+// media provider, so the win there is larger than on a plain desktop file.
+constexpr std::uint64_t kReadAheadBytes = 256 * 1024;
+
+using RawRead = std::function<std::size_t(std::uint64_t, void *, std::size_t)>;
+
+struct ReadAheadWindow {
+    std::mutex lock;
+    std::vector<std::uint8_t> data;
+    std::uint64_t base = 0;
+    std::size_t size = 0;
+    std::uint64_t hits = 0;
+    std::uint64_t misses = 0;
+    std::uint64_t served = 0;
