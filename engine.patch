diff --git a/host/android_vulkan_loader.cpp b/host/android_vulkan_loader.cpp
new file mode 100644
index 0000000..59187e6
--- /dev/null
+++ b/host/android_vulkan_loader.cpp
@@ -0,0 +1,111 @@
+// Android Vulkan loader bridge for the optional Adreno driver manager.
+//
+// wgpu-native loads libvulkan.so with dlopen() from inside libmain.so, so a
+// driver prepared through libadrenotools would normally be invisible to it:
+// the system linker would still hand wgpu the stock driver.
+//
+// This file closes that gap *without exporting dlopen/dlclose*. Exporting those
+// symbols overrides them for every library in the process, which is how the
+// 2.0 build could take down unrelated loaders on devices we never tested. The
+// build now passes -Wl,--wrap=dlopen -Wl,--wrap=dlclose, so only references
+// that are linked into libmain.so (wgpu, SDL, the emulator) are redirected and
+// the rest of the process keeps bionic's implementation.
+//
+// Everything is opt-in: without PS2_VK_DRIVER, __wrap_dlopen simply forwards to
+// __real_dlopen and the app behaves exactly like a stock-driver build.
+
+#if defined(__ANDROID__)
+
+#include <android/log.h>
+#include <dlfcn.h>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#ifdef PS2_ADRENOTOOLS
+#include <adrenotools/driver.h>
+#endif
+
+extern "C" void *__real_dlopen(const char *name, int flags);
+extern "C" int __real_dlclose(void *handle);
+
+namespace {
+
+constexpr const char *kTag = "GoW2Stats";
+
+void *g_vulkan_handle = nullptr;
+bool g_turbo = false;
+
+bool is_vulkan_name(const char *name) {
+    return name && (std::strcmp(name, "libvulkan.so") == 0 || std::strcmp(name, "libvulkan.so.1") == 0);
+}
+
+std::string env_or_empty(const char *key) {
+    const char *value = std::getenv(key);
+    return value ? std::string(value) : std::string();
+}
+
+} // namespace
+
+extern "C" void ps2_android_vulkan_prepare() {
+#ifdef PS2_ADRENOTOOLS
+    if (!g_turbo) {
+        const char *turbo = std::getenv("PS2_TURBO");
+        if (turbo && *turbo && std::strcmp(turbo, "0") != 0) {
+            adrenotools_set_turbo(true);
+            g_turbo = true;
+            __android_log_print(ANDROID_LOG_INFO, kTag, "[driver] turbo clock requested");
+        }
+    }
+
+    if (g_vulkan_handle) return;
+    if (std::getenv("PS2_SAFE")) return;
+
+    const std::string driverPath = env_or_empty("PS2_VK_DRIVER");
+    const std::string hookDir = env_or_empty("PS2_VK_HOOK_DIR");
+    const std::string tmpDir = env_or_empty("PS2_VK_TMP");
+    if (driverPath.empty() || hookDir.empty()) return;
+
+    const auto slash = driverPath.find_last_of('/');
+    const std::string driverDir = slash == std::string::npos ? std::string("./") : driverPath.substr(0, slash + 1);
+    const std::string driverName = slash == std::string::npos ? driverPath : driverPath.substr(slash + 1);
+    std::string tmp = tmpDir;
+    if (!tmp.empty() && tmp.back() != '/') tmp.push_back('/');
+
+    void *handle = adrenotools_open_libvulkan(
+        RTLD_NOW | RTLD_LOCAL, ADRENOTOOLS_DRIVER_CUSTOM,
+        tmp.empty() ? nullptr : tmp.c_str(), hookDir.c_str(),
+        driverDir.c_str(), driverName.c_str(), nullptr, nullptr);
+    if (!handle) {
+        __android_log_print(ANDROID_LOG_ERROR, kTag, "[driver] could not load %s (falling back to the system driver)", driverPath.c_str());
+        return;
+    }
+    g_vulkan_handle = handle;
+    __android_log_print(ANDROID_LOG_INFO, kTag, "[driver] custom Vulkan driver active: %s", driverPath.c_str());
+#else
+    (void)g_turbo;
+#endif
+}
+
+extern "C" __attribute__((visibility("hidden"))) void *__wrap_dlopen(const char *name, int flags) {
+    if (is_vulkan_name(name)) {
+        if (g_vulkan_handle) {
+            __android_log_print(ANDROID_LOG_INFO, kTag, "[driver] wgpu dlopen(%s) -> custom driver", name);
+            return g_vulkan_handle;
+        }
+        __android_log_print(ANDROID_LOG_INFO, kTag, "[driver] wgpu dlopen(%s) -> system driver", name);
+    }
+    return __real_dlopen(name, flags);
+}
+
+extern "C" __attribute__((visibility("hidden"))) int __wrap_dlclose(void *handle) {
+    if (handle && handle == g_vulkan_handle) {
+        // The driver stays mapped for the lifetime of the process; unloading a
+        // driver while a device is alive is not safe.
+        __android_log_print(ANDROID_LOG_INFO, kTag, "[driver] keeping the custom Vulkan driver loaded");
+        return 0;
+    }
+    return __real_dlclose(handle);
+}
+
+#endif
