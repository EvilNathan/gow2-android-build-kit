+    if (!bytes) return 0;
+    std::lock_guard<std::mutex> guard(g_read_ahead.lock);
+    ReadAheadWindow &window = g_read_ahead;
+    static const bool stats = std::getenv("PS2_DISC_STATS") != nullptr;
+    // Serve the request from the cached window when it fits entirely.
+    if (bytes <= window.size && offset >= window.base && offset + bytes <= window.base + window.size) {
+        std::memcpy(dst, window.data.data() + (offset - window.base), bytes);
+        ++window.hits;
+        window.served += bytes;
+    } else if (bytes >= kReadAheadBytes / 2 || offset + bytes > size) {
+        // Bulk or tail reads are cheaper straight through than through a window.
+        ++window.misses;
+        return raw(offset, dst, bytes);
+    } else {
+        const std::uint64_t base = offset & ~(kReadAheadBytes - 1);
+        const std::size_t want = static_cast<std::size_t>(
+            std::min<std::uint64_t>(kReadAheadBytes, base < size ? size - base : 0));
