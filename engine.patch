+bool open_fd(int fd, std::uint64_t size, const std::string &name) {
+#if defined(_WIN32)
+    (void)fd; (void)size; (void)name;
+    return false;
+#else
+    if (fd < 0 || size == 0) return false;
+    return open(name, size, [fd](std::uint64_t offset, void *out, std::size_t bytes) -> std::size_t {
+        std::uint8_t *p = static_cast<std::uint8_t *>(out);
+        std::size_t done = 0;
+        while (done < bytes) {
+            const ssize_t got = ::pread(fd, p + done, bytes - done, static_cast<off_t>(offset + done));
+            if (got < 0) {
+                if (errno == EINTR) continue;
+                break;
+            }
+            if (got == 0) break;
+            done += static_cast<std::size_t>(got);
+        }
+        return done;
+    });
+#endif
+}
