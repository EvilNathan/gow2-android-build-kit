new file mode 100644
index 0000000..42f8b15
--- /dev/null
+++ b/runtime/include/ps2/log.hpp
@@ -0,0 +1,89 @@
+#pragma once
+
+// Small process-wide logger. Every line goes to logcat (Android) and, when the
+// launcher sets PS2_LOG_FILE, to an append-only text file on external storage.
+// The file is flushed after each line so the last breadcrumb survives a native
+// crash: "adb logcat" is not always available on a phone, /sdcard/gow2/log.txt
+// is.
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <mutex>
+
+#if defined(__ANDROID__)
+#include <android/log.h>
+#endif
+
+namespace ps2::log {
+
+inline std::mutex &mutex() {
+    static std::mutex value;
+    return value;
+}
+
+inline FILE *&stream() {
+    static FILE *value = nullptr;
+    return value;
+}
+
+inline bool &opened() {
+    static bool value = false;
+    return value;
+}
+
+// 4 MiB cap: keep one previous file so a long session cannot fill the phone.
+inline void open_locked() {
+    if (opened()) return;
+    opened() = true;
+    const char *path = std::getenv("PS2_LOG_FILE");
+    if (!path || !*path) return;
+    if (FILE *probe = std::fopen(path, "rb")) {
+        std::fseek(probe, 0, SEEK_END);
+        const long size = std::ftell(probe);
+        std::fclose(probe);
+        if (size > 4L * 1024L * 1024L) {
+            char old[1024];
+            std::snprintf(old, sizeof old, "%s.old", path);
+            std::remove(old);
+            std::rename(path, old);
+        }
+    }
+    stream() = std::fopen(path, "a");
+}
+
+inline void init() {
+    std::lock_guard<std::mutex> guard(mutex());
+    open_locked();
+}
+
+inline void write(const char *fmt, ...) {
+    char message[1024];
+    va_list args;
+    va_start(args, fmt);
+    std::vsnprintf(message, sizeof message, fmt, args);
+    va_end(args);
+
+    std::time_t now = std::time(nullptr);
+    std::tm local{};
+#if defined(_WIN32)
+    localtime_s(&local, &now);
+#else
+    localtime_r(&now, &local);
+#endif
+    char stamp[16] = {};
+    std::strftime(stamp, sizeof stamp, "%H:%M:%S", &local);
+
+    std::lock_guard<std::mutex> guard(mutex());
+    open_locked();
+#if defined(__ANDROID__)
+    __android_log_print(ANDROID_LOG_INFO, "GoW2Stats", "%s", message);
+#endif
+    if (FILE *file = stream()) {
+        std::fprintf(file, "[%s] %s\n", stamp, message);
+        std::fflush(file);
+    }
+}
+
+} // namespace ps2::log
