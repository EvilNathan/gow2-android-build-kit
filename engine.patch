+// The generated code still needs the game's original ELF in memory at boot.
+// Pull it out of the user's ISO once, next to the app's save data.
+bool extract_elf(const std::string &path) {
+    auto entry = ps2::disc::find("SCUS_974.81");
+    if (!entry || entry->directory) {
+        std::fprintf(stderr, "[android] SCUS_974.81 not found in ISO\n");
+        return false;
+    }
+    if (std::FILE *existing = std::fopen(path.c_str(), "rb")) {
+        std::fseek(existing, 0, SEEK_END);
+        const long size = std::ftell(existing);
+        std::fclose(existing);
+        if (size == static_cast<long>(entry->size)) return true;
+    }
+    const std::string tmp = path + ".tmp";
+    std::FILE *out = std::fopen(tmp.c_str(), "wb");
+    if (!out) {
+        std::fprintf(stderr, "[android] cannot create %s\n", tmp.c_str());
+        return false;
+    }
+    std::vector<std::uint8_t> buffer(128 * ps2::disc::kSector);
+    std::uint32_t sector = entry->sector;
+    std::uint32_t remaining = entry->size;
+    bool ok = true;
+    while (remaining) {
+        const std::uint32_t sectors = (remaining + ps2::disc::kSector - 1) / ps2::disc::kSector;
+        const std::uint32_t count = std::min<std::uint32_t>(sectors, 128);
+        const std::uint32_t bytes = std::min<std::uint32_t>(remaining, count * ps2::disc::kSector);
+        if (!ps2::disc::read(sector, count, buffer.data())) { ok = false; break; }
+        if (std::fwrite(buffer.data(), 1, bytes, out) != bytes) { ok = false; break; }
+        sector += count;
+        remaining -= bytes;
+    }
+    std::fclose(out);
+    if (ok) {
+        std::remove(path.c_str());
+        if (std::rename(tmp.c_str(), path.c_str()) != 0) ok = false;
+    }
+    if (!ok) std::remove(tmp.c_str());
+    std::fprintf(stderr, "[android] extracted ELF: %s (%u bytes)\n", ok ? "ok" : "failed", entry->size);
+    return ok;
+}
+
 int usage() {
