+std::uint16_t touch_button_at(float x, float y) {
+    // Face buttons, diamond around (0.86, 0.70).
+    if (x > 0.74f && y > 0.52f && y < 0.88f) {
+        const float dx = x - 0.86f, dy = y - 0.70f;
+        if (dx * dx + dy * dy < 0.13f * 0.13f) {
+            if (std::fabs(dx) > std::fabs(dy)) return dx > 0 ? kCircle : kSquare;
+            return dy < 0 ? kTriangle : kCross;
+        }
+    }
+    if (x < 0.12f && y > 0.60f && y < 0.77f) return kL1;
+    if (x < 0.12f && y >= 0.77f && y < 0.94f) return kL2;
+    if (x > 0.88f && y > 0.60f && y < 0.77f) return kR1;
+    if (x > 0.88f && y >= 0.77f && y < 0.94f) return kR2;
+    if (x > 0.43f && x < 0.57f && y > 0.91f) return kStart;
+    if (x > 0.29f && x < 0.43f && y > 0.91f) return kSelect;
+    return 0;
+}
