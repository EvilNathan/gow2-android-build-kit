+// Very small built-in touch layout. It is deliberately screen-relative so it
+// works on every phone aspect ratio without a platform-specific overlay.
+enum class TouchMode { none, left_stick, right_stick, button };
+struct TouchState {
+    TouchMode mode = TouchMode::none;
+    std::uint16_t button = 0;
+    float x = 0.0f, y = 0.0f;
+};
+std::map<SDL_FingerID, TouchState> g_touches;
+std::atomic<std::uint16_t> g_virtual_buttons{0};
+std::atomic<std::uint8_t> g_virtual_lx{0x80}, g_virtual_ly{0x80}, g_virtual_rx{0x80}, g_virtual_ry{0x80};
+std::atomic<bool> g_paused{false};
+
+std::uint16_t touch_button_at(float x, float y) {
+    // Face buttons, diamond around (0.86, 0.70).
+    if (x > 0.74f && y > 0.52f && y < 0.88f) {
+        const float dx = x - 0.86f, dy = y - 0.70f;
+        if (dx * dx + dy * dy < 0.13f * 0.13f) {
+            if (std::fabs(dx) > std::fabs(dy)) return dx > 0 ? kCircle : kSquare;
+            return dy < 0 ? kTriangle : kCross;
+        }
+    }
+    if (x < 0.12f && y > 0.60f && y < 0.77f) return kL1;
+    if (x < 0.12f && y >= 0.77f && y < 0.94f) return kL2;
+    if (x > 0.88f && y > 0.60f && y < 0.77f) return kR1;
+    if (x > 0.88f && y >= 0.77f && y < 0.94f) return kR2;
+    if (x > 0.43f && x < 0.57f && y > 0.91f) return kStart;
+    if (x > 0.29f && x < 0.43f && y > 0.91f) return kSelect;
+    return 0;
+}
+
+void update_touch_axes() {
+    std::uint16_t buttons = 0;
+    float lx = 0.5f, ly = 0.5f, rx = 0.5f, ry = 0.5f;
+    bool left = false, right = false;
+    for (const auto &[id, t] : g_touches) {
+        (void)id;
+        if (t.mode == TouchMode::button) {
+            buttons |= t.button;
+        } else if (t.mode == TouchMode::left_stick) {
+            left = true;
+            lx = 0.5f + (t.x - 0.22f) * 2.5f;
+            ly = 0.5f + (t.y - 0.78f) * 2.5f;
+        } else if (t.mode == TouchMode::right_stick) {
+            right = true;
+            rx = 0.5f + (t.x - 0.64f) * 2.5f;
+            ry = 0.5f + (t.y - 0.72f) * 2.5f;
+        }
+    }
+    const auto to_byte = [](float v) {
+        return static_cast<std::uint8_t>(std::clamp(v, 0.0f, 1.0f) * 255.0f + 0.5f);
+    };
+    g_virtual_buttons.store(buttons);
+    g_virtual_lx.store(left ? to_byte(lx) : 0x80);
+    g_virtual_ly.store(left ? to_byte(ly) : 0x80);
+    g_virtual_rx.store(right ? to_byte(rx) : 0x80);
+    g_virtual_ry.store(right ? to_byte(ry) : 0x80);
+}
