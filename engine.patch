+// Keeps the latency-critical threads on the fastest CPU cluster on big.LITTLE
+// phones. Android's scheduler otherwise parks the EE thread on a little core
+// while the UI thread idles, which shows up as whole-frame stalls. This is a
+// no-op on desktop and when the topology cannot be read.
+void pin_current_thread(int role) {
+#ifdef __ANDROID__
+    struct Core {
+        int id;
+        long freq;
+    };
+    std::vector<Core> cores;
+    long top = 0;
+    for (int i = 0; i < 32; ++i) {
+        std::ifstream f("/sys/devices/system/cpu/cpu" + std::to_string(i) + "/cpufreq/cpuinfo_max_freq");
+        long khz = 0;
+        if (!(f >> khz) || khz <= 0) continue;
+        cores.push_back({i, khz});
+        top = std::max(top, khz);
+    }
+    if (cores.size() < 2 || top <= 0) return;
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    int count = 0;
+    std::string picked;
+    for (const Core &c : cores) {
+        const bool fast = static_cast<long long>(c.freq) * 100 >= static_cast<long long>(top) * 85;
+        if (role != 2 && !fast) continue;
+        CPU_SET(c.id, &set);
+        ++count;
+        if (!picked.empty()) picked += ",";
+        picked += std::to_string(c.id);
+    }
+    if (!count) return;
+    if (sched_setaffinity(0, sizeof(set), &set) != 0) return;
+    __android_log_print(ANDROID_LOG_INFO, "GoW2Stats", "[cpu] thread role %d -> cores %s (%ld kHz)", role, picked.c_str(), top);
+#else
+    (void)role;
+#endif
