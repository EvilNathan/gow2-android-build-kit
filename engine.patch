+bool skipped_program(std::uint64_t key) {
+    // PS2_VU_SKIP is a comma-separated list of 16-digit VU1 microcode hashes.
+    // The Android launcher uses it to keep the programs that were added in 2.0
+    // on the interpreter until each one is verified on hardware.
+    static const std::string spec = [] {
+        const char *env = std::getenv("PS2_VU_SKIP");
+        return env ? std::string(env) : std::string();
+    }();
+    if (spec.empty()) return false;
+    const char *p = spec.c_str();
+    while (*p) {
+        while (*p == ',' || std::isspace(static_cast<unsigned char>(*p))) ++p;
+        if (!*p) break;
+        char *end = nullptr;
+        const unsigned long long value = std::strtoull(p, &end, 16);
+        if (end == p) break;
+        if (value == key) return true;
+        p = end;
+    }
+    return false;
+}
