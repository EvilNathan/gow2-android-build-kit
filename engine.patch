+std::uint32_t le32(const std::uint8_t *p) {
+    return static_cast<std::uint32_t>(p[0]) | (static_cast<std::uint32_t>(p[1]) << 8) |
+           (static_cast<std::uint32_t>(p[2]) << 16) | (static_cast<std::uint32_t>(p[3]) << 24);
+}
+
+// GoW2 keeps the WAD/VPK/VAG files in PART1.PAK and PART2.PAK and indexes them
+// through GODOFWAR.TOC.  The IOP asks for them through its host1: device, so
+// expose the TOC entries as ordinary read-only files here.
+void load_toc() {
+    if (g_toc_loaded || g_toc_failed) return;
+    const auto toc = disc::find("GODOFWAR.TOC");
+    const auto part1 = disc::find("PART1.PAK");
+    const auto part2 = disc::find("PART2.PAK");
+    if (!toc || !part1 || !part2 || toc->size < 4) {
+        g_toc_failed = true;
+        return;
+    }
+    const std::uint32_t sectors = static_cast<std::uint32_t>((toc->size + disc::kSector - 1) / disc::kSector);
+    std::vector<std::uint8_t> data(static_cast<std::size_t>(sectors) * disc::kSector);
+    disc::read(toc->sector, sectors, data.data());
+    data.resize(toc->size);
+    const std::uint32_t count = le32(data.data());
+    const std::size_t entries_at = 4;
+    const std::size_t entries_end = entries_at + static_cast<std::size_t>(count) * 36;
+    if (entries_end > data.size()) {
+        g_toc_failed = true;
+        return;
+    }
+    const std::size_t offsets_count = (data.size() - entries_end) / 4;
+    for (std::uint32_t i = 0; i < count; ++i) {
+        const std::size_t at = entries_at + static_cast<std::size_t>(i) * 36;
+        std::string name;
+        for (std::size_t j = 0; j < 24 && data[at + j]; ++j) name += static_cast<char>(data[at + j]);
+        const std::uint32_t size = le32(data.data() + at + 24);
+        const std::uint32_t encounters = le32(data.data() + at + 28);
+        const std::uint32_t first = le32(data.data() + at + 32);
+        if (name.empty() || size == 0 || encounters == 0 || first >= offsets_count) continue;
+        const std::uint32_t offset_id = le32(data.data() + entries_end + static_cast<std::size_t>(first) * 4);
+        const std::uint32_t pak = offset_id / 10000000u;
+        const std::uint32_t sector = offset_id % 10000000u;
+        if (pak > 1) continue;
+        const std::uint64_t absolute = static_cast<std::uint64_t>(pak == 0 ? part1->sector : part2->sector) + sector;
+        if (absolute > 0xFFFFFFFFu) continue;
+        g_toc[upper(name)] = TocFile{static_cast<std::uint32_t>(absolute), size};
+    }
+    g_toc_loaded = true;
+    if (kernel::g_trace_hle) std::fprintf(stderr, "[io] loaded %zu TOC entries\n", g_toc.size());
+}
+
+const TocFile *toc_file(const std::string &path) {
+    load_toc();
+    if (g_toc.empty()) return nullptr;
+    std::string name = path;
+    const auto colon = name.find(':');
+    if (colon != std::string::npos) name = name.substr(colon + 1);
+    while (!name.empty() && (name.front() == '/' || name.front() == '\\')) name.erase(name.begin());
+    name = upper(name);
+    auto it = g_toc.find(name);
+    if (it != g_toc.end()) return &it->second;
+    constexpr const char *kPrefix = "WAD/";
+    if (name.rfind(kPrefix, 0) == 0) {
+        it = g_toc.find(name.substr(std::strlen(kPrefix)));
+        if (it != g_toc.end()) return &it->second;
+    }
+    const auto slash = name.find_last_of("/\\");
+    if (slash != std::string::npos) {
+        it = g_toc.find(name.substr(slash + 1));
+        if (it != g_toc.end()) return &it->second;
+    }
+    return nullptr;
+}
