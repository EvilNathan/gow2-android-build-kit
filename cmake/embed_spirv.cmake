# Embeds a directory of .spv files as C++ arrays.
#
#   cmake -DSPV_DIR=<dir> -DOUT_CPP=<file.cpp> -DOUT_H=<file.h> -P embed_spirv.cmake
#
# Generated API (declared in OUT_H, defined in OUT_CPP):
#
#   namespace gs_vk_spv {
#       struct Blob { const unsigned char *data; unsigned int size; };
#       Blob Get(const char *name);   // name = file name without ".spv"
#   }
#
# A missing name returns {nullptr, 0} instead of aborting, so a partial shader set
# still links and the backend can report the error itself.
if(NOT SPV_DIR OR NOT OUT_CPP OR NOT OUT_H)
    message(FATAL_ERROR "embed_spirv.cmake: SPV_DIR, OUT_CPP and OUT_H are required")
endif()

file(GLOB spv_files RELATIVE "${SPV_DIR}" "${SPV_DIR}/*.spv")
list(SORT spv_files)

set(declarations "")
set(arrays "")
set(lookups "")

foreach(spv ${spv_files})
    string(REGEX REPLACE "\\.spv$" "" logical "${spv}")
    string(MAKE_C_IDENTIFIER "gsvk_spv_${logical}" ident)
    file(READ "${SPV_DIR}/${spv}" hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
    string(APPEND declarations "extern const unsigned char ${ident}[];\nextern const unsigned int ${ident}_size;\n")
    string(APPEND arrays "const unsigned char ${ident}[] = {${bytes}};\nconst unsigned int ${ident}_size = sizeof(${ident});\n")
    string(APPEND lookups "    if (std::strcmp(name, \"${logical}\") == 0) return Blob{${ident}, ${ident}_size};\n")
endforeach()

file(WRITE "${OUT_H}"
"// Generated by cmake/embed_spirv.cmake — do not edit.\n"
"#ifndef GOW2_GS_VK_SHADERS_GENERATED_H\n"
"#define GOW2_GS_VK_SHADERS_GENERATED_H\n"
"\n"
"namespace gs_vk_spv {\n"
"struct Blob { const unsigned char *data; unsigned int size; };\n"
"Blob Get(const char *name);\n"
"${declarations}}\n"
"#endif\n")

file(WRITE "${OUT_CPP}"
"// Generated by cmake/embed_spirv.cmake — do not edit.\n"
"#include \"gs_vk_shaders_generated.h\"\n"
"#include <cstring>\n"
"\n"
"namespace gs_vk_spv {\n"
"${arrays}"
"Blob Get(const char *name)\n"
"{\n"
"    if (name == nullptr) return Blob{nullptr, 0u};\n"
"${lookups}"
"    return Blob{nullptr, 0u};\n"
"}\n"
"}\n")

message(STATUS "embed_spirv: ${spv_files}")
