diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 6c576db..5cc9ff8 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -38,6 +38,7 @@ static bool gowUsePcsx2Vu1(); // GOW_VU1_PCSX2=1, defined before PS2Runtime::ini
 #include <sstream>
 #include <cstdio>
 #include <cstdlib>
+#include <system_error>
 
 // GOW-Port: audio device position for the movie A/V check (GOW_MPEG_DIAG, Kernel/Stubs/MPEG.cpp): frames the device
 // has played (including silence fill) and frames the sound engine produced (= GOW_AUDIO_PCM file position).
@@ -1214,11 +1215,95 @@ void PS2Runtime::configureIoPathsFromElf(const std::string &elfPath)
         paths.elfDirectory = paths.elfPath.parent_path();
     }
 
-    if (!paths.elfDirectory.empty())
+    if (paths.elfDirectory.empty())
     {
-        paths.hostRoot = paths.elfDirectory;
-        paths.cdRoot = paths.elfDirectory;
-        paths.mcRoot = paths.elfDirectory / "mc0";
+        paths.elfDirectory = ".";
+    }
+
+    paths.hostRoot = paths.elfDirectory;
+    paths.cdRoot = paths.elfDirectory;
+    paths.mcRoot = paths.elfDirectory / "mc0";
+
+    // Kit: serve the disc straight from the ISO image instead of a copied disc tree.
+    auto checkValidIso = [](const std::filesystem::path &p) -> bool {
+        if (p.empty()) return false;
+        std::error_code ec;
+        if (std::filesystem::is_regular_file(p, ec))
+        {
+            auto sz = std::filesystem::file_size(p, ec);
+            if (!ec && sz > 100 * 1024 * 1024ULL) return true;
+        }
+        FILE *f = std::fopen(p.string().c_str(), "rb");
+        if (f)
+        {
+            std::fseek(f, 0, SEEK_END);
+            long sz = std::ftell(f);
+            std::fclose(f);
+            if (sz > 100 * 1024 * 1024L) return true;
+        }
+        return false;
+    };
+
+    const char *isoOverride = std::getenv("GOW2_ISO");
+    std::filesystem::path chosenIso;
+
+    if (isoOverride && *isoOverride && checkValidIso(isoOverride))
+    {
+        chosenIso = isoOverride;
+    }
+    else
+    {
+        const std::vector<std::filesystem::path> candidates = {
+            paths.elfDirectory / "gow2.iso",
+            paths.elfDirectory / "God of War II.iso",
+            "/sdcard/gow2/gow2.iso",
+            "/sdcard/gow2/God of War II.iso",
+            "/storage/emulated/0/gow2/gow2.iso",
+            "/storage/emulated/0/gow2/God of War II.iso"
+        };
+        for (const auto &cand : candidates)
+        {
+            if (checkValidIso(cand))
+            {
+                chosenIso = cand;
+                break;
+            }
+        }
+
+        if (chosenIso.empty())
+        {
+            const std::vector<std::filesystem::path> searchDirs = {
+                paths.elfDirectory,
+                "/sdcard/gow2",
+                "/storage/emulated/0/gow2"
+            };
+            for (const auto &dir : searchDirs)
+            {
+                std::error_code ec;
+                if (std::filesystem::is_directory(dir, ec))
+                {
+                    for (const auto &entry : std::filesystem::directory_iterator(dir, ec))
+                    {
+                        if (entry.path().extension() == ".iso" && checkValidIso(entry.path()))
+                        {
+                            chosenIso = entry.path();
+                            break;
+                        }
+                    }
+                }
+                if (!chosenIso.empty()) break;
+            }
+        }
+    }
+
+    if (!chosenIso.empty())
+    {
+        paths.cdImage = chosenIso;
+        std::cout << "[ps2_runtime] CD image set to: " << paths.cdImage.string() << std::endl;
+    }
+    else
+    {
+        std::cerr << "[ps2_runtime] WARNING: No valid CD image found! Checked GOW2_ISO, /sdcard/gow2, app files" << std::endl;
     }
 
     setIoPaths(paths);
