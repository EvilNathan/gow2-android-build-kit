-// TODO: on-screen touch joystick / button overlay.
+// Kit: Android game entry point. The Java host starts this on its own thread from
+// NativeBridge.nativeStart(); the engine's desktop main() is not used on Android.
+#include "ps2_runtime.h"
+
 #if defined(__ANDROID__)
-#endif // __ANDROID__
+#include "ps2x_host.h"
+
+#include <cstdlib>
+#include <string>
+#include <exception>
+#include <iostream>
+
+void ps2InstallEeDiff(PS2Runtime &runtime); // src/lib/ee_ref/ee_diff.cpp
+void ps2InstallEeWatch(PS2Runtime &runtime);
+void ps2InstallEePageWatch(PS2Runtime &runtime);
+
+#ifndef PS2X_DEFAULT_BOOT_ELF
+#define PS2X_DEFAULT_BOOT_ELF ""
+#endif
+
+namespace
+{
+    std::string bootElfPath()
+    {
+        if (const char *fromHost = std::getenv("GOW2_BOOT_ELF"); fromHost && *fromHost)
+            return fromHost;
+        return PS2X_DEFAULT_BOOT_ELF;
+    }
+}
+
+extern "C" int ps2x_android_game_main(void)
+{
+    ps2x::host::RequestExit(); // clear a pending exit from a previous session
+    const std::string filePathStr = bootElfPath();
+    if (filePathStr.empty())
+    {
+        ps2x::host::Log("ps2x", "[android] no boot ELF configured (GOW2_BOOT_ELF)");
+        return 2;
+    }
+
+    try
+    {
+        ps2x::host::Log("ps2x", "[android] booting %s", filePathStr.c_str());
+        PS2Runtime runtime;
+        if (!runtime.initialize("God of War II"))
+        {
+            ps2x::host::Log("ps2x", "[android] runtime initialize failed");
+            return 1;
+        }
+        if (!runtime.loadELF(filePathStr))
+        {
+            ps2x::host::Log("ps2x", "[android] loadELF failed: %s", filePathStr.c_str());
+            return 3;
+        }
+        ps2InstallEeDiff(runtime);
+        ps2InstallEeWatch(runtime);
+        ps2InstallEePageWatch(runtime);
+        runtime.run();
+        std::cout.flush();
+        std::cerr.flush();
+        ps2x::host::Log("ps2x", "[android] game loop finished");
+        return 0;
+    }
+    catch (const std::exception &e)
+    {
+        ps2x::host::Log("ps2x", "[android] fatal: %s", e.what());
+    }
+    catch (...)
+    {
+        ps2x::host::Log("ps2x", "[android] fatal: unknown exception");
+    }
+    return 1;
+}
+#else
+extern "C" int ps2x_android_game_main(void) { return 0; }
+#endif
